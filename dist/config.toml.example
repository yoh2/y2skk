# y2skk configuration file
# Place this file at: ~/.config/y2skk/config.toml
#
# All settings are optional. Uncomment and edit the ones you want to change.
# The values shown below are the defaults.
#
# To validate this file without starting the daemon:
#   y2skk-daemon --check-config
#   y2skk-daemon --check-config --config /path/to/config.toml

[input]
# Kana input layout.
# The value is used as the filename stem to locate the table file:
#   <data dir>/y2skk/tables/<kana_layout>.txt
# Search order: $XDG_CONFIG_HOME, $XDG_DATA_HOME, $XDG_DATA_DIRS.
# Built-in layouts installed by `cargo xtask install`:
#   romaji / azik-us / azik-jp / dvorakjp-us / dvorakjp-jp
kana_layout = "romaji"

# Explicit path to a kana table file.
# When set, kana_layout is ignored.
# A leading ~ is expanded to the home directory.
# kana_table = "~/.config/y2skk/tables/my-layout.txt"

# Default input mode on startup.
# Options: ascii / hiragana / katakana / half-width-katakana / wide-ascii
default_mode = "ascii"

# Keys that toggle the IME between enabled (hiragana) and disabled (ASCII) mode.
# Each entry is a combination of modifiers and a key name joined with "+".
# Modifier names: shift / ctrl / alt / meta (or super)
# Key names: space / return / tab / escape / or a single character
toggle_keys = ["shift+space"]

# Characters that immediately start conversion in ▽ mode.
# When one of these characters is typed, the current reading is converted and
# the trigger character is also committed.
# Set to [] to disable.
conversion_trigger_chars = [",", ".", "を"]

# vi-compatible behaviour: when enabled, pressing Esc in a normal input mode
# (Hiragana, Katakana, Half-width Katakana, Wide-ASCII, or ASCII) switches the
# IME to ASCII mode so that vi/vim normal-mode keys (hjkl etc.) are not
# intercepted by the IME.  Conversion phases (▽/▼ and dictionary registration)
# keep their existing Esc = cancel semantics.
# vi_escape = false

[user-dict]
# Path to the user dictionary file.
# The file is created automatically if it does not exist.
# A leading ~ is expanded to the home directory.
# Default: ~/.local/share/y2skk/user.dict
# path = "~/.local/share/y2skk/user.dict"

[dict]
# When true, (skk-ignore-dic-word "word" ...) entries in dictionaries are
# interpreted: the listed words are filtered out from the candidate list.
# This is standard SKK behaviour.  Disable only if you encounter problems
# with a specific dictionary file.
# lisp_directives = true

# System dictionaries (multiple entries allowed).
# Higher priority values are searched first.
# The user dictionary always has the highest priority.
# A leading ~ in path is expanded to the home directory.

# Example: system-installed SKK dictionary
# [[dict.sources]]
# path = "/usr/share/skk/SKK-JISYO.L"
# encoding = "euc-jp"   # utf-8 / euc-jp
# priority = 0

# [[dict.sources]]
# path = "/usr/share/skk/SKK-JISYO.jinmei"
# encoding = "euc-jp"
# priority = -1

[indicator]
# Show a small popup when the input mode changes.
enabled = true

# How long (in milliseconds) the indicator is shown before hiding automatically.
# Set to 0 to keep it always visible.
timeout_ms = 2000

[candidates]
# Number of candidates shown inline (one by one) before switching to list mode.
inline_count = 3

# Keys used to select a candidate in list mode.
# The leftmost character selects the first candidate, the next selects the
# second, and so on.
selection_keys = "asdfjkl;"

[daemon]
# Log level: trace / debug / info / warn / error
# The RUST_LOG environment variable takes precedence over this setting.
log_level = "info"
